# ╔══════════════════════════════════════════════════════════════╗
# ║  AGGILO MVP — ENVIRONMENT VARIABLES                        ║
# ║  Copy this file to .env.local and fill in the values       ║
# ║  Run: cp .env.example .env.local                           ║
# ╚══════════════════════════════════════════════════════════════╝

# ── SUPABASE ──────────────────────────────────────────────────
# Get these from: https://supabase.com/dashboard → Project → Settings → API
#
# NEXT_PUBLIC_ prefix makes these available in browser code.
# The anon key is safe to expose — RLS policies protect data.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# ── LLM API (for Sage) ───────────────────────────────────────
# Sage uses an OpenAI-compatible chat completions API.
# This works with: NVIDIA NIM, DeepSeek, OpenRouter, Together, etc.
#
# NVIDIA NIM free tier (40 RPM):
#   LLM_BASE_URL=https://integrate.api.nvidia.com/v1
#   LLM_API_KEY=nvapi-your-key-here
#   LLM_MODEL=deepseek-ai/deepseek-r1
#
# DeepSeek direct:
#   LLM_BASE_URL=https://api.deepseek.com/v1
#   LLM_API_KEY=your-deepseek-key
#   LLM_MODEL=deepseek-chat
#
# OpenRouter (access to many models):
#   LLM_BASE_URL=https://openrouter.ai/api/v1
#   LLM_API_KEY=your-openrouter-key
#   LLM_MODEL=deepseek/deepseek-chat
#
LLM_BASE_URL=https://integrate.api.nvidia.com/v1
LLM_API_KEY=your-api-key-here
LLM_MODEL=deepseek-ai/deepseek-r1

# ── APP CONFIG ────────────────────────────────────────────────
# The public URL of your deployed app (used for auth redirects)
# In development, this is http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

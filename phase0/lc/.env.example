# ╔══════════════════════════════════════════════════════════════╗
# ║  AGGILO — LONG CONVERSATION                                  ║
# ║  Phase 0 generic cluster · environment variables             ║
# ║  Copy this file to .env.local and fill in the values         ║
# ║  Run: cp .env.example .env.local                             ║
# ╚══════════════════════════════════════════════════════════════╝

# ── SUPABASE ──────────────────────────────────────────────────
# Same Supabase project as the MVP (Sisters in Dua). The cluster_id
# column scopes data per cluster — we share the project but never the
# rows. RLS + cluster_id filter on every query enforces this.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# ── CLUSTER CONFIGURATION ─────────────────────────────────────
# Hard-coded to long_conversation for this app. Every Supabase query
# in this codebase scopes by this cluster_id. If you ever fork this
# app for a third cluster, change this value and re-run the schema
# scope migration.
NEXT_PUBLIC_CLUSTER_ID=long_conversation

# ── BASE PATH ─────────────────────────────────────────────────
# Path prefix this app is mounted under. Empty in development so the
# app runs at http://localhost:3001/cluster. In production set to
# /c/long-conversation so URLs match the rewrite from aggilo.in.
#
# Whatever value you set here MUST also appear in the marketing site's
# vercel.json rewrite rules (launch/landing/vercel.json) and in the
# Supabase Auth Redirect URLs allow-list.
NEXT_PUBLIC_BASE_PATH=

# ── PRIMARY LLM (for Sage and Clio) ───────────────────────────
# OpenAI-compatible chat completions API.
# Recommended: NVIDIA NIM (free tier, 40 RPM):
#   LLM_BASE_URL=https://integrate.api.nvidia.com/v1
#   LLM_API_KEY=nvapi-your-key-here
#   LLM_MODEL=moonshotai/kimi-k2-5
LLM_BASE_URL=https://integrate.api.nvidia.com/v1
LLM_API_KEY=your-api-key-here
LLM_MODEL=moonshotai/kimi-k2-5

# ── FALLBACK LLM (reliability) ────────────────────────────────
# Optional. If primary 429s or 5xxs, fall back here.
LLM_FALLBACK_BASE_URL=
LLM_FALLBACK_API_KEY=
LLM_FALLBACK_MODEL=

# ── LLM BUDGET CAP ────────────────────────────────────────────
LLM_DAILY_BUDGET_USD=5

# ── ADMIN ALLOWLIST ───────────────────────────────────────────
# Comma-separated emails. Members matching this list are auto-promoted
# to role='admin' on first sign-in. For Long Conversation Phase 0,
# this is the platform admin.
ADMIN_EMAILS=

# ── FOUNDING MEMBER ALLOWLIST ─────────────────────────────────
# Comma-separated emails. The member(s) whose request produced this
# cluster (Source A in the intake taxonomy). On first sign-in, their
# profile gets `is_founding_member = true`, which triggers the
# founding-member feedback prompt described in
# phase0/docs/AMA_CLUSTER_CREATION_AND_FOUNDING_FEEDBACK.md Part 1.
#
# For Long Conversation: tasneem.bano@gmail.com (Tas).
# When the intake pipeline ships in Phase 1, this is replaced with a
# lookup against cluster_intake_signals.
FOUNDING_MEMBER_EMAILS=

# ── APP CONFIG ────────────────────────────────────────────────
# The public URL of your deployed app. In production this is
# https://aggilo.in (the rewrite mounts the app at /c/long-conversation
# under that domain). In development, http://localhost:3001 with no
# basePath. The auth/check-email route uses this for the magic-link
# emailRedirectTo, so it must be the public origin, not the
# .vercel.app deployment URL.
NEXT_PUBLIC_APP_URL=http://localhost:3001

# ── ANALYTICS ─────────────────────────────────────────────────
# Google Analytics 4 measurement ID. Loaded via next/script with
# afterInteractive strategy. Set both initial pageview AND SPA route
# changes (handled by src/components/Analytics.tsx).
#
# The MVP (Sisters in Dua) uses G-KKB8DL5024. You can use the same
# property for unified platform analytics, or create a separate GA
# property for Long Conversation if you want per-cluster attribution.
# Leave blank to disable GA in development.
NEXT_PUBLIC_GA_ID=

# Microsoft Clarity project ID. Captures session recordings + heatmaps.
# Clarity tracks SPA route changes automatically (no extra wiring needed).
#
# The MVP uses ww0ad0gm76. Same call: reuse for unified platform analytics
# or create a separate Clarity project for per-cluster attribution.
# Leave blank to disable Clarity in development.
NEXT_PUBLIC_CLARITY_ID=

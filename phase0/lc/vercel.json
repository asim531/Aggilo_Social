{
  "framework": "nextjs",

  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "/c/long-conversation/api/:path*"
    },
    {
      "source": "/_next/:path*",
      "destination": "/c/long-conversation/_next/:path*"
    }
  ],

  "crons": [
    {
      "path": "/api/notifications/reengagement",
      "schedule": "0 3 * * *"
    }
  ],

  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        }
      ]
    }
  ]
}

# ╔══════════════════════════════════════════════════════════════╗
# ║  AGGILO MVP — ENVIRONMENT VARIABLES                          ║
# ║  Copy this file to .env.local and fill in the values         ║
# ║  Run: cp .env.example .env.local                             ║
# ╚══════════════════════════════════════════════════════════════╝

# ── SUPABASE ──────────────────────────────────────────────────
# Get these from: https://supabase.com/dashboard → Project → Settings → API
#
# NEXT_PUBLIC_ prefix makes these available in browser code.
# The anon key is safe to expose — RLS policies protect data.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Service role key — used only by server-side code that needs to bypass
# RLS (e.g. behavioural events ingestion, admin elevation). Never expose.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# ── PRIMARY LLM (for Sage and Clio) ───────────────────────────
# Sage uses an OpenAI-compatible chat completions API.
# This works with: NVIDIA NIM, DeepSeek, OpenRouter, Together, etc.
#
# NVIDIA NIM free tier (40 RPM):
#   LLM_BASE_URL=https://integrate.api.nvidia.com/v1
#   LLM_API_KEY=nvapi-your-key-here
#   LLM_MODEL=moonshotai/kimi-k2-5
#
# DeepSeek direct:
#   LLM_BASE_URL=https://api.deepseek.com/v1
#   LLM_API_KEY=your-deepseek-key
#   LLM_MODEL=deepseek-chat
#
LLM_BASE_URL=https://integrate.api.nvidia.com/v1
LLM_API_KEY=your-api-key-here
LLM_MODEL=moonshotai/kimi-k2-5

# ── FALLBACK LLM (Token-max + reliability) ────────────────────
# Optional but recommended. If the primary provider returns 429 / 5xx /
# timeout, the system falls back here. Pick a different provider so the
# fallback isn't subject to the same rate limit.
#
# Recommended pairing — primary NVIDIA NIM, fallback DeepSeek:
#   LLM_FALLBACK_BASE_URL=https://api.deepseek.com/v1
#   LLM_FALLBACK_API_KEY=your-deepseek-key
#   LLM_FALLBACK_MODEL=deepseek-chat
#
LLM_FALLBACK_BASE_URL=
LLM_FALLBACK_API_KEY=
LLM_FALLBACK_MODEL=

# ── LLM BUDGET CAP (Token-max guardrail) ──────────────────────
# Daily soft cap in USD. When exceeded, agents return a graceful
# "stepping back" placeholder instead of hitting the LLM. Logged.
# Default $5. Raise when you have observability and trust the loops.
LLM_DAILY_BUDGET_USD=5

# ── ADMIN ALLOWLIST (Three archetypes — DRI) ──────────────────
# Comma-separated emails. On first sign-in, profiles matching this list
# are auto-promoted to role='founder' (displayed as "Admin" in premium
# clusters). The list is also persisted to platform_settings — you can
# update it from the admin dashboard later.
ADMIN_EMAILS=

# ── APP CONFIG ────────────────────────────────────────────────
# The public URL of your deployed app (used for auth redirects)
# In development, this is http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000
